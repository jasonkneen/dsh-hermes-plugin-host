{
  "name": "dsh-hermes-plugin-host",
  "version": "1.0.0",
  "type": "module",
  "description": "Install and run Hermes Desktop plugins inside DeepSeek Harness: a Hermes Plugins page, an @hermes/plugin-sdk runtime, and a Python FastAPI sidecar for plugin backends.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**",
    "client.js",
    "web/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hermes",
    "hermes-plugin",
    "plugin-host",
    "office-3d"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonkneen/dsh-hermes-plugin-host.git"
  },
  "homepage": "https://github.com/jasonkneen/dsh-hermes-plugin-host#readme",
  "bugs": {
    "url": "https://github.com/jasonkneen/dsh-hermes-plugin-host/issues"
  }
}
